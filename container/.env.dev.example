# Ambiente de DESENVOLVIMENTO. Copie para .env.dev e ajuste.
#
#   docker compose --env-file container/.env.dev -f container/docker-compose.dev.yml up -d
#
# O .env.dev NAO vai para o versionamento.

# IP da maquina de dev, para acessar a stack de outro dispositivo da rede.
# Deixe `localhost` se so for usar na propria maquina.
DEV_HOST_IP=localhost

# Portas publicadas no host. Se voce roda App_Compra_inteligente (8001/5174/5433)
# ou Bi_controle_financeiro (8000/5173/5432) ao mesmo tempo, mude estas aqui.
API_HOST_PORT=8000
WEB_HOST_PORT=5173
DB_HOST_PORT=5433
