# Ambiente de PRODUCAO (VPS). Copie para .env e ajuste.
# O .env NAO vai para o versionamento.

# --- Conta administrativa protegida ---
# Usada na criacao da conta `admin` (migration 0007). So tem efeito se a conta
# ainda nao existir — trocar a senha depois e feito direto no banco.
# DEFINA AQUI EM PRODUCAO: o padrao do codigo e publico para quem ve o repositorio.
ADMIN_SENHA_INICIAL=troque-esta-senha

# --- Django ---
SECRET_KEY=troque-por-um-valor-aleatorio-longo
DEBUG=0
# 127.0.0.1 e obrigatorio: e o host usado pelo healthcheck do container.
ALLOWED_HOSTS=bi.suaempresa.com.br,bi-margem-lucro-api,127.0.0.1
LOG_LEVEL=INFO

# --- Postgres (roda NO HOST da VPS, nao no compose) ---
POSTGRES_DB=bi_margem
POSTGRES_USER=bi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# --- Frontend ---
CORS_ALLOWED_ORIGINS=https://bi.suaempresa.com.br
VITE_API_URL=/bi-margem-lucro/api/v1
VITE_BASE_PATH=/bi-margem-lucro/
URL_PREFIX=/bi-margem-lucro

# --- Rede compartilhada entre as stacks da VPS ---
SOFTWARE_NETWORK=internal-services

# --- Carga de dados ---
# Os CSVs do Protheus sao enviados pelo administrador na tela "Carga de dados".
# Limite por arquivo (os exports reais tem entre 2 e 5 MB).
MAX_UPLOAD_CSV_MB=50
